[
  {
    "id": "termux-ipa-sideloading",
    "title": "TermuxからIPAをサイドロードする",
    "sections": [
      {
        "title": "usbmuxd",
        "steps": [
          {
            "desc": "スリープ対策を有効化",
            "cmd": "termux-wake-lock"
          },
          {
            "desc": "USBデバイスのパスを確認",
            "cmd": "termux-usb -l"
          },
          {
            "desc": "usbmuxdを起動",
            "note": "(2)で確認したパスが/dev/bus/usb/001/002と異なる場合は状況に応じて書き換える",
            "cmd": "termux-usb -r -E -e \"usbmuxd -f -v --socket $PREFIX/var/run/usbmuxd\" /dev/bus/usb/001/002"
          }
        ]
      },
      {
        "title": "X11用セッション",
        "steps": [
          {
            "desc": "X11を起動",
            "cmd": "termux-x11 :1 -legacy-drawing"
          }
        ]
      },
      {
        "title": "作業用セッション",
        "steps": [
          {
            "desc": "USB通信を確認",
            "cmd": "USBMUXD_SOCKET_ADDRESS=\"UNIX:$PREFIX/var/run/usbmuxd\" idevice_id -l"
          },
          {
            "desc": "Ubuntu環境に入る",
            "cmd": "proot-distro login ubuntu --shared-tmp --bind \"$PREFIX/var/run:/run\" --bind \"$HOME/storage/downloads:/mnt/downloads\""
          },
          {
            "desc": "実行時ディレクトリを用意",
            "cmd": "install -d -m 700 /tmp/runtime-root"
          },
          {
            "desc": "環境変数を設定",
            "cmd": "export XDG_RUNTIME_DIR=/tmp/runtime-root"
          },
          {
            "desc": "USBデバイスとの通信を確認",
            "cmd": "USBMUXD_SOCKET_ADDRESS=\"UNIX:/run/usbmuxd\" ideviceinfo -k ProductVersion"
          },
          {
            "desc": "X11上にターミナルを表示",
            "cmd": "DISPLAY=:1 xterm"
          }
        ]
      },
      {
        "title": "iLoader",
        "steps": [
          {
            "desc": "iLoaderを起動",
            "note": "X11上のターミナルで実行",
            "cmd": "XDG_RUNTIME_DIR=/tmp/runtime-root DISPLAY=:1 GDK_BACKEND=x11 LIBGL_ALWAYS_SOFTWARE=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 USBMUXD_SOCKET_ADDRESS=\"/run/usbmuxd\" dbus-launch --exit-with-session iloader"
          }
        ]
      }
    ]
  },
  {
    "id": "opencode-public",
    "title": "opencode web serverを公開する",
    "sections": [
      {
        "title": "バックエンド",
        "steps": [
          {
            "desc": "opencode web serverをバックエンドで起動",
            "cmd": "opencode serve --hostname 127.0.0.1 --port 4096 > ~/opencode.log 2>&1 &"
          }
        ]
      },
      {
        "title": "Cloudflare Tunnel",
        "steps": [
          {
            "desc": "cloudflare tunnelを起動",
            "cmd": "cloudflared tunnel --protocol http2 run opencode"
          }
        ]
      }
    ]
  }
]